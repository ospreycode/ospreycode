{
	"name": "@ospreycode/cli",
	"version": "0.1.0",
	"description": "命令行界面：子命令、交互界面、非交互运行和对外的事件流",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ospreycode/ospreycode.git",
		"directory": "packages/cli"
	},
	"type": "module",
	"bin": {
		"ospreycode": "./dist/bundle/ospreycode.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"vendor",
		"licenses",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/bundle.ts"
	},
	"dependencies": {
		"@earendil-works/pi-tui": "1.5.0",
		"@napi-rs/keyring": "2.1.2",
		"@ospreycode/agent-host": "0.1.0"
	},
	"devDependencies": {
		"esbuild": "0.28.2",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": "^24.15.0 || >=26.0.0"
	}
}
